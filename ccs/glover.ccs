[ 8-bit realm ]
sub 8-bit_realm
    call setup_aborts
    call init
    if monstername "*blooper*"
        call olfactory
    endif
    call main
    "repeat"
endsub
call 8-bit_realm

[ accordion thief ]
sub setup_aborts
    "abort (monstername 'Krakrox the Barbarian')"
    #"abort (!mppercentbelow 100)"
    "abort missed 6"
    "abort pastround 9"
    "abort hppercentbelow 50"
endsub
sub doClassStun
    if hasskill steal accordion
        skill steal accordion
    endif
endsub
sub hit
    attack with weapon
endsub

