[ global prefix ]
scrollwhendone
sub setup_aborts
    "abort (monstername 'Krakrox the Barbarian')"
    #"abort (!mppercentbelow 100)"
    "abort missed 6"
    "abort pastround 9"
    "abort hppercentbelow 50"
endsub
sub doClassStun
endsub
sub hit
    attack with weapon
endsub
sub doPickpocket
    if !monstername "beefy bodyguard bat"
        if !monstername "sabre-toothed lime" && !monstername "dairy ooze"
            if !monstername "minion" && !monstername "May Jones" && !monstername "Mr. Huge" && !monstername "Number Five"
                try to steal an item
                try to steal an item
            endif
        endif
    endif
endsub
sub doItems
endsub
sub init
    call doPickpocket
    call doItems
    call doClassStun
    skill sing along
endsub
# default main, uses different hits based on class
sub main
    call heal
    call hit
endsub
# heals with saucy salve up to 2 times
sub heal
    if hascombatitem anti-anti-antidote
        if haseffect Hardly Poisoned at All || haseffect A Little Bit Poisoned || haseffect Somewhat Poisoned || haseffect Really Quite Poisoned || haseffect Majorly Poisoned
            item anti-anti-antidote
        endif
    endif
endsub
sub olfactory
    call heal
endsub
sub banish
    skill kgb tranquilizer dart
endsub

