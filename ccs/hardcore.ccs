[ global prefix ]
scrollwhendone
sub setup_aborts
    "abort haseffect beaten up"
    #"abort (!mppercentbelow 100)"
    "abort haseffect teleportitis"
    "abort missed 3"
    "abort pastround 11"
    "abort hppercentbelow 25"
endsub
sub doClassStun
    skill club foot
endsub
sub hit
    attack with weapon
endsub
sub big_hit
    skill lunging thrust-smack
endsub
sub doPickpocket
    if !monstername "beefy bodyguard bat"  && !monstername "sabre-toothed lime" && !monstername "dairy ooze"
        if !monstername "minion" && !monstername "May Jones" && !monstername "Mr. Huge" && !monstername "Number Five"
            try to steal an item
            try to steal an item
        endif
    endif
endsub
sub doItems
    if sauceror
        skill curse of weaksauce
    endif
    #use beehive
    item rock band flyers,beehive
endsub
sub init
    call doPickpocket
    call doItems
    call doClassStun
    skill sing along
endsub
# default main, uses different hits based on class
sub main
    call hit
endsub
sub big_main
    call big_hit
endsub
# heals with saucy salve up to 2 times
sub heal
    if hppercentbelow 80 && !muscleclass && hasskill saucy salve
        if !times 2
            skill saucy salve
            call heal
        endif
    endif
    if hascombatitem anti-anti-antidote
        if haseffect Hardly Poisoned at All || haseffect A Little Bit Poisoned || haseffect Somewhat Poisoned || haseffect Really Quite Poisoned || haseffect Majorly Poisoned
            item anti-anti-antidote
        endif
    endif
endsub
sub olfactory
    call heal
    skill transcendent olfaction
endsub
sub banish
    if !hasskill KGB tranquilizer dart && hasskill Asdon Martin: Spring-loaded Front Bumper
        skill asdon martin: spring-loaded front bumper
    endif
    if hasskill KGB tranquilizer dart
        skill kgb tranquilizer dart
    endif
endsub

