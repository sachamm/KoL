sub doClassStun
    call heal
    skill disco dance of doom
    skill disco dance ii: electric boogaloo
    note unknown/ambiguous skill disco dance iii
    if (hasskill pop and lock it && hasskill break it on down && hasskill run like the wind)
        combo Rave Steal
        combo Rave Concentration
        combo Rave Nirvana
        note unknown combo Rave Stats
    endif
endsub
