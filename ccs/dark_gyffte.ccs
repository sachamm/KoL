[ global prefix ]
scrollwhendone
sub setup_aborts
    "abort missed 1"
    "abort pastround 5"
    "abort hppercentbelow 40"
endsub
sub doClassStun
endsub
sub big_hit
    skill chill of the tomb
endsub
sub hit
    attack with weapon
endsub
sub doPickpocket
    if !monstername "beefy bodyguard bat"
        if !monstername "sabre-toothed lime" && !monstername "dairy ooze"
            try to steal an item
            try to steal an item
        endif
    endif
endsub
sub doItems
    "skill micrometeorite"
    #use rock band flyers
    #call heal
    #use beehive
endsub
sub init
    call doPickpocket
    call doItems
    call doClassStun
    skill sing along
endsub
sub main
    call heal
    attack with weapon
endsub
sub big_main
    call heal
    skill chill of the tomb
endsub
sub heal
    if monsterhpbelow 101 && hppercentbelow 99
        skill dark feast
    endif
endsub
sub olfactory
    call heal
    skill offer latte to opponent
endsub
sub banish
    skill kgb tranquilizer dart
endsub

