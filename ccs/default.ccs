[ global prefix ]
scrollwhendone
"icon club"
sub setup_aborts
    if !turtletamer
        "abort missed 6"
        "abort pastround 9"
        "abort hppercentbelow 50"
    endif
    if turtletamer
        "abort missed 10"
        "abort pastround 16"
        "abort hppercentbelow 10"
    endif
    if sauceror
        "abort mpbelow 15"
    endif
endsub
sub doPickpocket
    if !monstername "beefy bodyguard bat" & !monstername "daft punk"
        if !monstername "sabre-toothed lime" && !monstername "dairy ooze"
            if !monstername "minion" && !monstername "May Jones" && !monstername "Mr. Huge" && !monstername "Number Five"
                try to steal an item
                if hasskill pickpocket
                    try to steal an item
                endif
                if match "You fish around in your opponent's pocket, but you don't find anything" && hasskill "run like the wind" && hasskill "pop and lock it" && hasskill "break it on down"
                    combo Rave Steal
                endif
            endif
        endif
    endif
endsub
# called once at the beginning of all sequences
sub init
    call doPickpocket
    item Time-Spinner
    if hasskill extract jelly
        call heal
        skill extract jelly
    endif
    if sauceror
        call heal
        skill curse of weaksauce
    endif
    if discobandit
        call heal
        skill disco dance of doom
        skill disco dance ii: electric boogaloo
    endif
endsub
sub olfactory
    call heal
    skill transcendent olfaction
endsub
sub banish
    skill kgb tranquilizer dart
endsub
# default main, uses different hits based on class
sub main
    call heal
    call hit
endsub
sub attack_main
    call heal
    attack with weapon
endsub
sub spell_main
    call heal
    skill saucestorm
endsub
sub bigspell_main
    call heal
    skill saucegeyser
endsub
# heals with saucy salve up to 2 times
sub heal
    if hppercentbelow 90 && !turtletamer && hasskill saucy salve
        if !times 2
            skill saucy salve
            call heal
        endif
    endif
    if hascombatitem anti-anti-antidote
        if haseffect Hardly Poisoned at All || haseffect A Little Bit Poisoned || haseffect Somewhat Poisoned || haseffect Really Quite Poisoned || haseffect Majorly Poisoned
            item anti-anti-antidote
        endif
    endif
endsub
sub hit
    if sauceror
        skill saucestorm
    endif
    if turtletamer || discobandit
        attack with weapon
    endif
endsub

